{"52057":"Мне больно! Сильно!","52058":"На помощь, друзья!","52059":"Долгий выдался денёк. Не помешало бы выпить.","52060":"Ага.","52061":"Не-а.","52062":"Будем здоровы!","52063":"Ура!","52064":"Самое время для кружки эля и пары слов.","52065":"Проваливай! А не то клинок тебе в зад, понял?!","52066":"В атаку!","52067":"Защищайся!","52068":"Тебя осудили — и ты не прошёл!","52069":"Земля поглотит тебя!","52070":"Мне совсем худо. Исцели меня!","52071":"Мне нужна помощь! Помоги мне!","52072":"Здравствуй.","52073":"Да.","52074":"Нет.","52075":"Прощай.","52076":"Так и должно быть!","52077":"Нам надо поговорить, друг.","52078":"Гляди под ноги, дурень!","52079":"Бей этих кровавых ублюдков!","52080":"Сволочи!","52081":"Я раскрою твой треклятый череп!","52082":"Сдохните, псы!","52083":"Подлечите меня!","52084":"Мне тут нужна подмога!","52085":"Эй, чего?","52086":"Ага.","52087":"Не-а.","52088":"Убирайся прочь.","52089":"Так и должно быть!","52090":"Поговори со мной.","52091":"Гляди под ноги, когда рядом со мной, дурень.","52092":"Прикончи эту мразь! Задай им как следует!","52093":"Кровь и преисподняя!","52094":"Моя мощь сотрёт тебя в порошок!","52095":"Сдохни!","52096":"Я ранен! Исцели меня!","52097":"Помогите! Помогите!","52098":"Добрый день!","52099":"Да.","52100":"Нет.","52101":"Бывай!","52102":"Вот так-то оно и делается!","52103":"Мне очень нужно с тобой поговорить.","52104":"Тронешь меня — нарвёшься на БОЛЬШУЮ беду. Вот увидишь!","52105":"Бей их!","52106":"Я укорочу тебя на голову!","52107":"Получай!","52108":"Зло падёт предо мной!","52109":"Я ранен!","52110":"Прошу, помоги мне!","52111":"Привет тебе.","52112":"Да.","52113":"Нет.","52114":"Прощай.","52115":"Ну надо же!","52116":"Подойди, поболтаем.","52117":"Ты напрашиваешься на хорошую трёпку!","52118":"Приказываю атаковать! Все в атаку!","52119":"Ты умрёшь от моей руки!","52120":"О-о, я тебя славно отделаю!","52121":"Ра-агх! Рнах! Нррах!","52122":"Лечения! Сюда! Живо!","52123":"Помогите! Помогите мне!","52124":"Тебе здесь рады.","52125":"Да.","52126":"Нет!","52127":"Пока. Прощай!","52128":"Это хорошо!","52129":"Иди сюда. Слушай.","52130":"Гляди в оба, не то сдохнешь! Всё просто.","52131":"Не щадить никого! В атаку!","52132":"Рраааагхх!!","52133":"Пади предо мной!","52134":"Ты умрёшь!","52135":"Мне нужно лечение. Живо.","52136":"Ко мне! Живо! Помоги мне!","52137":"Приветствую тебя.","52138":"Да.","52139":"Нет.","52140":"Прощай.","52141":"Да!","52142":"Говори со мной. Здесь.","52143":"Будешь испытывать судьбу — и я выдавлю из тебя жизнь.","52144":"Призови свою ярость. В атаку, живо!","52145":"Из рук моих — древняя ярость!","52146":"Века бешенства! Века огня!"}