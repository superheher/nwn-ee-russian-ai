# Python venv
.venv/
__pycache__/
*.pyc

# Build artifact - rebuilt by build_tlk.py / install_ru.py
build/

# Local backups of the game files + install manifest (machine-specific)
backup/

# Russifier assets - extracted from the .exe via innoextract (see README)
payload/

# Generated translation artifacts (regenerable)
glossary/mined_glossary.tsv
glossary/anchors.txt
context/pilot_input.json
context/pilot_output.json
context/player_report_fixes.json

# Derived inputs - regenerable from the game + scripts (not committed)
context/convos/
context/dialogs/
context/sysbatches/
context/otherbatches/
context/manifests/
context/worklists/
context/system_map.json
context/dialog_index.json
context/coverage.json
# NOTE: context/translated/ (our actual translations) IS committed, per-chunk.

# DoID DLC (premium/paid): module binary + extracted ENGLISH source are NOT committed
# (Beamdog IP, regenerable from the game). Our RU translations under doid/translated/ ARE committed.
doid/*.nwm
doid/strings.json
doid/*.en.json
doid/pilot.*.json

# DDF (Dark Dreams of Furiae) DLC — same rule: module/hak binaries + extracted
# English source not committed; our RU translations (ddf/translated/) ARE committed.
ddf/*.nwm
ddf/*.hak
ddf/batches/
ddf/index.json
ddf/override/
ddf/override_manifest.txt

# Premium DLC modules (Daggerford, Moonsea, Infinite Dungeons, etc.) — same rule as
# DDF/DoID: extracted ENGLISH source (batches/index) not committed (Beamdog IP,
# regenerable from the game); our RU translations (dlc/*/translated/) ARE committed.
dlc/*/batches/
dlc/*/index.json
dlc/*/*.nwm
dlc/*/*.mod
dlc/*/*.hak
dlc/*/override/

# Voice dubbing experiments: game audio (IP) + venvs + generated TTS — not
# committed. voice_training scripts/docs stay committable; cast_compare/ holds
# audio samples. .venv-f5/ is not matched by the .venv/ rule above (other name).
voice_data/
voice_pilot/
voice_training/cast_compare/
.venv-f5/

# macOS
.DS_Store
tools/
